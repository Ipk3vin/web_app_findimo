{
  "buildCommand": "npm run build -- --output-mode static && node scripts/vercel-index.mjs",
  "outputDirectory": "dist/personas-frontend/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://findimo-api.onrender.com/api/:path*" },
    { "source": "/imagenes/:path*", "destination": "https://findimo-api.onrender.com/imagenes/:path*" }
  ]
}
